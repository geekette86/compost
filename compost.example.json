{
  "listen": ":8080",
  "cache_dir": "/var/cache/compost",
  "upstream_timeout": "5m",
  "max_object_size": 1073741824,
  "mirrors": [
    {
      "name": "packagist",
      "upstream": "https://repo.packagist.org/",
      "ttl": "1m"
    },
    {
      "name": "github-api",
      "upstream": "https://api.github.com/repos/",
      "allowed_paths": ["^[^/]+/[^/]+/(zipball|tarball)/[^/]+$"],
      "headers": { "Authorization": "Bearer ${GITHUB_TOKEN}" }
    },
    {
      "name": "github-codeload",
      "upstream": "https://codeload.github.com/",
      "allowed_paths": ["^[^/]+/[^/]+/(legacy\\.zip|legacy\\.tar\\.gz|zip|tar\\.gz)/.+$"]
    },
    {
      "name": "drupal",
      "upstream": "https://packages.drupal.org/",
      "ttl": "5m"
    }
  ]
}
